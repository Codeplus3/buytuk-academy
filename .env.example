# ============================================================================
# BuyTuk Educational Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Primary connection string (Replit standard)
DATABASE_URL=postgresql://user:password@localhost:5432/buytuk

# Platform-specific alias (either DATABASE_URL or BUYTUK_DATABASE_URL required)
# BUYTUK_DATABASE_URL=postgresql://user:password@localhost:5432/buytuk

# ----------------------------------------------------------------------------
# Session & Security
# ----------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# JWT settings (if using JWT auth)
# JWT_SECRET=replace-with-another-long-random-string
# JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------------------
# AI Services (optional — required for AI analysis features)
# ----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------------------
# File Storage (optional — required for evidence/media uploads)
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=me-south-1
# AWS_S3_BUCKET=buytuk-evidence

# ----------------------------------------------------------------------------
# Notifications (optional)
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
