{
  "name": "buytuk-academy",
  "version": "1.0.0",
  "description": "Unified Educational Platform - BuyTuk Academy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@buytuk/api",
    "dev:web": "turbo run dev --filter=@buytuk/web",
    "dev:worker": "turbo run dev --filter=@buytuk/worker",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@buytuk/api",
    "build:web": "turbo run build --filter=@buytuk/web",
    "build:worker": "turbo run build --filter=@buytuk/worker",
    "build:engines": "turbo run build --filter=\"./engines/*\"",
    "build:domains": "turbo run build --filter=\"./domains/*\"",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:dist": "turbo run clean",
    "db:generate": "turbo run db:generate --filter=@buytuk/database",
    "db:migrate": "turbo run db:migrate --filter=@buytuk/database",
    "db:push": "turbo run db:push --filter=@buytuk/database",
    "db:seed": "turbo run db:seed --filter=@buytuk/database",
    "db:studio": "turbo run db:studio --filter=@buytuk/database",
    "proto:generate": "./scripts/generate-proto.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:gpu": "docker-compose --profile gpu up -d",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "setup": "./scripts/setup-dev.sh",
    "prepare": "husky install",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^9.3.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "@next/eslint-plugin-next": "^14.2.3",
    "globals": "^15.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "^3.2.5",
    "turbo": "^2.0.3",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.4.5"
    }
  }
}